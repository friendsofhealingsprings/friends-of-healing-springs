---
import type { Project } from '../data/projects';
import { projectStatusColors } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="brand-card flex flex-col overflow-hidden transition-colors hover:border-stone-300">
  <div class="aspect-[16/10] overflow-hidden bg-sand-100">
    <img
      src={project.image}
      alt={project.imageAlt}
      class="h-full w-full object-cover"
      loading="lazy"
    />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 flex items-center justify-between gap-2">
      <span
        class:list={[
          'inline-flex rounded-brand px-3 py-1 text-xs font-semibold uppercase tracking-wide',
          projectStatusColors[project.status],
        ]}
      >
        {project.statusLabel}
      </span>
    </div>
    <h3 class="font-serif text-xl font-semibold text-forest-800">{project.title}</h3>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600">{project.description}</p>
    {
      project.fundingNotes && (
        <div class="mt-4 rounded-brand border border-stone-200 bg-base p-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-stone-500">Funding Notes</p>
          <p class="mt-1 text-sm text-stone-600">{project.fundingNotes}</p>
        </div>
      )
    }
  </div>
</article>
