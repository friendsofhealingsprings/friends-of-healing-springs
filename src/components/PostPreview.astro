---
import { contentDateIso, formatContentDate } from '../utils/date';

interface Props {
  title: string;
  description: string;
  href: string;
  date: Date;
  image?: string;
  imageAlt?: string;
}

const { title, description, href, date, image, imageAlt = '' } = Astro.props;

const formattedDate = formatContentDate(date);
---

<article class="brand-card group overflow-hidden transition-colors hover:border-stone-300">
  {
    image && (
      <a href={href} class="block aspect-[16/9] overflow-hidden bg-sand-100">
        <img
          src={image}
          alt={imageAlt}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      </a>
    )
  }
  <div class="p-6">
    <time datetime={contentDateIso(date)} class="text-sm text-stone-500">{formattedDate}</time>
    <h3 class="mt-2 font-serif text-xl font-semibold text-forest-800">
      <a href={href} class="no-underline hover:text-water-700">{title}</a>
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-stone-600">{description}</p>
    <a
      href={href}
      class="mt-4 inline-flex items-center text-sm font-semibold text-water-700 no-underline hover:text-water-800"
    >
      Read more
      <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
      </svg>
    </a>
  </div>
</article>
