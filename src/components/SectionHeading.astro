---
interface Props {
  title: string;
  subtitle?: string;
  centered?: boolean;
  light?: boolean;
}

const { title, subtitle, centered = false, light = false } = Astro.props;
---

<div class:list={['mb-10', centered && 'text-center']}>
  <h2
    class:list={[
      'text-3xl font-semibold tracking-tight md:text-4xl',
      light ? 'text-white' : 'text-forest-800',
    ]}
  >
    {title}
  </h2>
  {
    subtitle && (
      <p
        class:list={[
          'mt-3 max-w-2xl text-lg leading-relaxed',
          light ? 'text-sand-100' : 'text-stone-600',
          centered && 'mx-auto',
        ]}
      >
        {subtitle}
      </p>
    )
  }
</div>
