---
import { mainNav } from '../data/navigation';
---

<header class="sticky top-0 z-50 border-b border-stone-200 bg-base/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-content items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="group flex shrink-0 items-center no-underline">
      <img
        src="/brand/logo/logo-horizontal.svg"
        alt="Friends of Healing Springs Natural Area"
        class="hidden h-11 w-auto sm:block"
        width="320"
        height="64"
      />
      <img
        src="/logo.svg"
        alt="Friends of Healing Springs Natural Area"
        class="h-10 w-10 sm:hidden"
        width="40"
        height="40"
      />
    </a>

    <nav class="hidden items-center gap-1 xl:flex" aria-label="Main navigation">
      {
        mainNav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-brand px-3 py-2 text-sm font-medium transition-colors no-underline',
              Astro.url.pathname === item.href ||
              (item.href !== '/' && Astro.url.pathname.startsWith(item.href))
                ? 'bg-water-50 text-water-700'
                : 'text-stone-700 hover:bg-sand-100 hover:text-forest-700',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      id="mobile-menu-button"
      class="inline-flex items-center justify-center rounded-brand p-2 text-stone-700 hover:bg-sand-100 hover:text-forest-700 xl:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open navigation menu"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-stone-200 bg-base xl:hidden"
    aria-label="Mobile navigation"
  >
    <div class="space-y-1 px-4 py-4">
      {
        mainNav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'block rounded-brand px-3 py-2 text-base font-medium no-underline',
              Astro.url.pathname === item.href ||
              (item.href !== '/' && Astro.url.pathname.startsWith(item.href))
                ? 'bg-water-50 text-water-700'
                : 'text-stone-700 hover:bg-sand-100',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
