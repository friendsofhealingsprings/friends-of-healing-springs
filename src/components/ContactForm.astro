---
interface Props {
  id: string;
  formType?: 'general' | 'volunteer' | 'partnership';
  title?: string;
  submitLabel?: string;
  note?: string;
}

const {
  id,
  formType = 'general',
  title = 'Send a Message',
  submitLabel = 'Submit',
  note = 'Messages are sent securely to our team. We typically respond within a few business days.',
} = Astro.props;
---

<div class="brand-card p-6 md:p-8">
  <h3 class="font-serif text-xl font-semibold text-forest-800">{title}</h3>
  <p class="mt-2 text-sm text-stone-600">{note}</p>

  <form
    id={id}
    class="contact-form mt-6 space-y-5"
    data-form-type={formType}
    novalidate
  >
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for={`${id}-website`}>Website</label>
      <input type="text" id={`${id}-website`} name="website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for={`${id}-name`} class="block text-sm font-medium text-stone-700">
          Name <span class="text-stone-500">*</span>
        </label>
        <input
          type="text"
          id={`${id}-name`}
          name="name"
          required
          class="mt-1 block w-full rounded-brand border border-stone-300 bg-base px-4 py-2.5 text-stone-900 focus:border-water-500 focus:outline-none focus:ring-1 focus:ring-water-500"
          autocomplete="name"
        />
      </div>
      <div>
        <label for={`${id}-email`} class="block text-sm font-medium text-stone-700">
          Email <span class="text-stone-500">*</span>
        </label>
        <input
          type="email"
          id={`${id}-email`}
          name="email"
          required
          class="mt-1 block w-full rounded-brand border border-stone-300 bg-base px-4 py-2.5 text-stone-900 focus:border-water-500 focus:outline-none focus:ring-1 focus:ring-water-500"
          autocomplete="email"
        />
      </div>
    </div>

    <div>
      <label for={`${id}-subject`} class="block text-sm font-medium text-stone-700">
        Subject
      </label>
      <input
        type="text"
        id={`${id}-subject`}
        name="subject"
        class="mt-1 block w-full rounded-brand border border-stone-300 bg-base px-4 py-2.5 text-stone-900 focus:border-water-500 focus:outline-none focus:ring-1 focus:ring-water-500"
      />
    </div>

    <div>
      <label for={`${id}-message`} class="block text-sm font-medium text-stone-700">
        Message <span class="text-stone-500">*</span>
      </label>
      <textarea
        id={`${id}-message`}
        name="message"
        rows="5"
        required
        class="mt-1 block w-full rounded-brand border border-stone-300 bg-base px-4 py-2.5 text-stone-900 focus:border-water-500 focus:outline-none focus:ring-1 focus:ring-water-500"
      ></textarea>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <button
        type="submit"
        class="contact-form-submit rounded-brand bg-water-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-water-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-water-600 disabled:cursor-not-allowed disabled:opacity-60"
      >
        {submitLabel}
      </button>
      <p class="contact-form-status hidden text-sm text-stone-600" aria-live="polite"></p>
    </div>
  </form>
</div>
