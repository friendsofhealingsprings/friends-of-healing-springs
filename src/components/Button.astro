---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline';
  href: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  external?: boolean;
}

const {
  variant = 'primary',
  href,
  size = 'md',
  class: className = '',
  external = false,
} = Astro.props;

const base =
  'inline-flex items-center justify-center rounded-brand font-medium transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-water-600';

const variants = {
  primary: 'bg-water-600 text-white hover:bg-water-700',
  secondary: 'bg-teal-600 text-white hover:bg-teal-700',
  outline: 'border border-stone-300 bg-base text-forest-700 hover:bg-sand-100',
};

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};
---

<a
  href={href}
  class:list={[base, variants[variant], sizes[size], className]}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
</a>
