---
const interests = [
  { value: 'General cleanup/debris removal', label: 'General cleanup/debris removal' },
  { value: 'Trail cleanup and stewardship', label: 'Trail cleanup and stewardship' },
  { value: 'Vegetation/small-branch trimming', label: 'Vegetation/small-branch trimming' },
  { value: 'Equipment/mower support', label: 'Equipment/mower support' },
  { value: 'Hauling/debris transport', label: 'Hauling/debris transport' },
  { value: 'General “wherever needed”', label: 'General “wherever needed”' },
  { value: 'Other', label: 'Other' },
];

const equipment = [
  { value: 'Riding mower', label: 'Riding mower' },
  { value: 'Utility trailer', label: 'Utility trailer' },
  { value: 'Hand tools for vegetation trimming', label: 'Hand tools for vegetation trimming' },
  { value: 'Other useful equipment', label: 'Other useful equipment' },
];
---

<div id="rsvp" class="brand-card scroll-mt-28 p-6 md:p-8">
  <h2 class="font-serif text-2xl font-semibold text-forest-800">RSVP for the Fall Cleanup &amp; Stewardship Workday</h2>
  <p class="mt-3 text-sm leading-relaxed text-stone-600">
    Let us know you're coming! You can stay for an hour or spend the whole day with us. Tell us what
    kinds of projects you're interested in so we can plan the workday and make sure we have the people
    and equipment we need.
  </p>
  <p class="mt-2 text-sm leading-relaxed text-stone-600">
    Submitting an RSVP does <strong>not</strong> mean you have to stay for the entire event.
  </p>

  <form class="rsvp-form mt-6 space-y-6" novalidate>
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for="rsvp-website">Website</label>
      <input type="text" id="rsvp-website" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="rsvp-first-name" class="block text-sm font-medium text-stone-700">
          First name <span class="text-stone-500">*</span>
        </label>
        <input
          type="text"
          id="rsvp-first-name"
          name="firstName"
          required
          autocomplete="given-name"
          class="mt-1 block w-full rounded-brand border border-stone-300 bg-base px-4 py-2.5 text-stone-900 focus:border-water-500 focus:outline-none focus:ring-1 focus:ring-water-500"
        />
      </div>
      <div>
        <label for="rsvp-last-name" class="block text-sm font-medium text-stone-700">
          Last name <span class="text-stone-500">*</span>
        </label>
        <input
          type="text"
          id="rsvp-last-name"
          name="lastName"
          required
          autocomplete="family-name"
          class="mt-1 block w-full rounded-brand border border-stone-300 bg-base px-4 py-2.5 text-stone-900 focus:border-water-500 focus:outline-none focus:ring-1 focus:ring-water-500"
        />
      </div>
    </div>

    <div>
      <label for="rsvp-email" class="block text-sm font-medium text-stone-700">
        Email address <span class="text-stone-500">*</span>
      </label>
      <input
        type="email"
        id="rsvp-email"
        name="email"
        required
        autocomplete="email"
        class="mt-1 block w-full rounded-brand border border-stone-300 bg-base px-4 py-2.5 text-stone-900 focus:border-water-500 focus:outline-none focus:ring-1 focus:ring-water-500"
      />
    </div>

    <fieldset>
      <legend class="text-sm font-medium text-stone-700">
        Will you be attending? <span class="text-stone-500">*</span>
      </legend>
      <div class="mt-3 flex flex-wrap gap-4">
        <label class="inline-flex items-center gap-2 text-sm text-stone-700">
          <input type="radio" name="attending" value="Yes" required class="text-water-600 focus:ring-water-500" />
          Yes
        </label>
        <label class="inline-flex items-center gap-2 text-sm text-stone-700">
          <input type="radio" name="attending" value="Maybe" class="text-water-600 focus:ring-water-500" />
          Maybe
        </label>
      </div>
    </fieldset>

    <fieldset>
      <legend class="text-sm font-medium text-stone-700">
        Approximate participation <span class="text-stone-500">*</span>
      </legend>
      <div class="mt-3 grid gap-2 sm:grid-cols-2">
        <label class="inline-flex items-center gap-2 text-sm text-stone-700">
          <input type="radio" name="participation" value="Morning" required class="text-water-600 focus:ring-water-500" />
          Morning
        </label>
        <label class="inline-flex items-center gap-2 text-sm text-stone-700">
          <input type="radio" name="participation" value="Afternoon" class="text-water-600 focus:ring-water-500" />
          Afternoon
        </label>
        <label class="inline-flex items-center gap-2 text-sm text-stone-700">
          <input type="radio" name="participation" value="Most/all day" class="text-water-600 focus:ring-water-500" />
          Most/all day
        </label>
        <label class="inline-flex items-center gap-2 text-sm text-stone-700">
          <input type="radio" name="participation" value="Not sure yet" class="text-water-600 focus:ring-water-500" />
          Not sure yet
        </label>
      </div>
    </fieldset>

    <fieldset>
      <legend class="text-sm font-medium text-stone-700">Volunteer interests</legend>
      <p class="mt-1 text-xs text-stone-500">Choose as many as you like. Work will depend on what is needed that day.</p>
      <div class="mt-3 grid gap-2">
        {
          interests.map((item) => (
            <label class="inline-flex items-start gap-2 text-sm text-stone-700">
              <input
                type="checkbox"
                name="interests"
                value={item.value}
                class="mt-0.5 text-water-600 focus:ring-water-500"
              />
              {item.label}
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset>
      <legend class="text-sm font-medium text-stone-700">Equipment you can bring (optional)</legend>
      <p class="mt-1 text-xs text-stone-500">
        Only bring equipment you are comfortable operating. Tools and equipment are optional.
      </p>
      <div class="mt-3 grid gap-2">
        {
          equipment.map((item) => (
            <label class="inline-flex items-start gap-2 text-sm text-stone-700">
              <input
                type="checkbox"
                name="equipment"
                value={item.value}
                class="mt-0.5 text-water-600 focus:ring-water-500"
              />
              {item.label}
            </label>
          ))
        }
      </div>
      <label for="rsvp-equipment-notes" class="mt-4 block text-sm font-medium text-stone-700">
        Describe any equipment you'd like to bring
      </label>
      <textarea
        id="rsvp-equipment-notes"
        name="equipmentNotes"
        rows="3"
        class="mt-1 block w-full rounded-brand border border-stone-300 bg-base px-4 py-2.5 text-stone-900 focus:border-water-500 focus:outline-none focus:ring-1 focus:ring-water-500"
      ></textarea>
    </fieldset>

    <div>
      <label for="rsvp-notes" class="block text-sm font-medium text-stone-700">
        Anything else we should know?
      </label>
      <textarea
        id="rsvp-notes"
        name="notes"
        rows="4"
        class="mt-1 block w-full rounded-brand border border-stone-300 bg-base px-4 py-2.5 text-stone-900 focus:border-water-500 focus:outline-none focus:ring-1 focus:ring-water-500"
      ></textarea>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <button
        type="submit"
        class="rsvp-form-submit rounded-brand bg-water-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-water-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-water-600 disabled:cursor-not-allowed disabled:opacity-60"
      >
        Send RSVP
      </button>
      <p class="rsvp-form-status hidden text-sm text-stone-600" role="status" aria-live="polite"></p>
    </div>
  </form>
</div>
