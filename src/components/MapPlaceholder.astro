---
/**
 * MapPlaceholder — Future Leaflet/Mapbox integration point
 *
 * Usage (future):
 * import MapPlaceholder from '../components/MapPlaceholder.astro';
 * <MapPlaceholder client:load lat={36.261} lng="-94.349" zoom={14} />
 *
 * Install: npm install leaflet (or mapbox-gl)
 * Add map tiles and markers for Healing Springs Natural Area boundary
 */
interface Props {
  lat?: number;
  lng?: number;
  zoom?: number;
  class?: string;
}

const {
  lat = 36.261,
  lng = -94.349,
  zoom = 14,
  class: className = '',
} = Astro.props;
---

<div
  class:list={['map-placeholder rounded-brand border-2 border-dashed border-stone-300 bg-sand-100', className]}
  data-lat={lat}
  data-lng={lng}
  data-zoom={zoom}
  id="map-container"
  role="img"
  aria-label="Map of Healing Springs Natural Area — interactive map coming soon"
>
  <div class="flex min-h-[300px] flex-col items-center justify-center p-8 text-center">
    <svg class="mb-4 h-12 w-12 text-stone-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
    </svg>
    <p class="font-serif text-lg font-semibold text-stone-600">Interactive Map</p>
    <p class="mt-2 max-w-sm text-sm text-stone-500">
      Healing Springs Natural Area, Highfill, Arkansas
    </p>
    <p class="mt-1 text-xs text-stone-400">Leaflet.js integration planned</p>
  </div>
</div>
