# Cloudflare Pages local secrets — copy to .dev.vars (never commit .dev.vars)

# Optional extra: also email inquiries if all three Resend vars are set.
# Contact forms require MAILERLITE_API_KEY (same key as newsletter signup).
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@friendsofhealingsprings.org
CONTACT_FROM_EMAIL=Friends of Healing Springs <notify@friendsofhealingsprings.org>
STRIPE_SECRET_KEY=
SITE_URL=http://localhost:8788

# Newsletter signup and contact-form inquiries (volunteer, partnership, general).
MAILERLITE_API_KEY=
# Optional: add new newsletter subscribers to a specific MailerLite group
MAILERLITE_GROUP_ID=
# Optional overrides. If unset, contact.ts finds or creates MailerLite groups by name:
#   volunteer   → "Volunteer Inquiries"
#   partnership → "Partnership Inquiries"
#   general     → "Website Inquiries"
# RSVP form finds or creates "Fall Cleanup RSVPs" unless overridden:
MAILERLITE_RSVP_GROUP_ID=
MAILERLITE_VOLUNTEER_GROUP_ID=
MAILERLITE_PARTNERSHIP_GROUP_ID=
MAILERLITE_CONTACT_GROUP_ID=
